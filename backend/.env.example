# Environment: development | production
# production always requires authentication and refuses the local SQLite stand-in.
ENVIRONMENT=development

# Microsoft Fabric SQL Database (transactional endpoint, not the analytics endpoint)
# Copy the server from the SQL database connection string in the Fabric portal.
# Example shape: <workspace-id>.database.fabric.microsoft.com
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=
FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# auto | interactive | token | service_principal
# interactive opens a browser for local development
FABRIC_AUTH_MODE=interactive

# Microsoft Entra application used by the API when a client secret is required.
# Leave the secret empty to use DefaultAzureCredential (az login or managed identity).
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# Development only. Ignored when ENVIRONMENT=production.
FABRIC_LOCAL_SQLITE=false
FABRIC_LOCAL_SQLITE_PATH=./data/edt_local.sqlite

# OneLake file storage. Leave blank to keep files on local disk.
ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com
ONELAKE_WORKSPACE=
ONELAKE_LAKEHOUSE=

# Application JWT (existing email/password login)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# jwt keeps the current login. entra or both also accepts Microsoft Entra access tokens.
AUTH_PROVIDER=jwt
# When true, an employee can only access their own twin, their direct reports, or HR scope.
# ENVIRONMENT=production forces this on.
AUTH_ENFORCE=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Google Gemini / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=

# App
APP_NAME=Digital Twin v3
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local file storage used when OneLake is not configured
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

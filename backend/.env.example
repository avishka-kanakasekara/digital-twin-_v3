# Database
DATABASE_URL=postgresql+asyncpg://digitaltwin:digitaltwin@localhost:5432/digitaltwin_db
DATABASE_URL_SYNC=postgresql+psycopg2://digitaltwin:digitaltwin@localhost:5432/digitaltwin_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Auth
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini (for AI Career Coach)
GOOGLE_API_KEY=your-gemini-api-key

# App
APP_NAME=Digital Twin v3
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

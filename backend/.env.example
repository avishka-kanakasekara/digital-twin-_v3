# Environment: development | production
# production always requires authentication and refuses the local SQLite stand-in.
ENVIRONMENT=development

# Backend-only session pooler URI from the Supabase project Connect panel.
# Put the filled URI in the ignored backend/.env.local file.
DATABASE_PROVIDER=supabase
SUPABASE_DB_URL=

# Isolated local development only
FABRIC_LOCAL_SQLITE=false
FABRIC_LOCAL_SQLITE_PATH=./data/edt_local.sqlite

# OneLake file storage. Leave blank to keep files on local disk.
ONELAKE_ACCOUNT_URL=https://onelake.dfs.fabric.microsoft.com
ONELAKE_WORKSPACE=
ONELAKE_LAKEHOUSE=

# Application JWT (existing email/password login)
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# jwt keeps the current login. entra or both also accepts Microsoft Entra access tokens.
AUTH_PROVIDER=jwt
# When true, an employee can only access their own twin, their direct reports, or HR scope.
# ENVIRONMENT=production forces this on.
AUTH_ENFORCE=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Google Gemini / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=

# App
APP_NAME=Digital Twin v3
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local file storage used when OneLake is not configured
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
